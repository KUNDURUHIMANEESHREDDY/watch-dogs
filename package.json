{
  "name": "watchdog",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-terminal watchdog: captures every shell session (incl. IDE terminals), judges output with rules + optional LLM second opinion, and applies fixes under hard safety rails.",
  "type": "module",
  "bin": {
    "wd": "./bin/wd.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test test/",
    "wd": "node bin/wd.js",
    "sandbox": "node sandbox/run-sandbox.mjs",
    "sandbox:live": "node sandbox/run-sandbox.mjs",
    "daemon-test": "node sandbox/run-daemon-test.mjs",
    "daemon-test:live": "node sandbox/run-daemon-test.mjs",
    "langfuse-test": "node sandbox/run-langfuse-test.mjs",
    "verify": "npm test && npm run sandbox"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  }
}
